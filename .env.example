# Copy this file to .env.local (recommended) or .env
# DO NOT commit .env/.env.local to git.
# Vite only exposes variables prefixed with VITE_ to the browser.

# Main backend base URL used by most endpoints (credit score, feedback, register, etc.)
# Example: https://backend.migofin.com
VITE_BACKEND_URL=

# Backend base URL used by SIWE (wallet auth) endpoints
# Example: https://dev.migofin.com
VITE_DEV_URL=

# Optional (recommended for local dev if backend CORS is not configured):
# When true, frontend will call same-origin `/api/...` and Vite dev server will proxy to VITE_BACKEND_URL.
VITE_USE_VITE_PROXY=false

# WalletConnect Cloud project id (required if using WalletConnect)
# Create one at https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=
